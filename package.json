{
  "name": "cntxt",
  "private": true,
  "version": "0.5.7",
  "type": "module",
  "scripts": {
    "dev": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js",
    "build": "node --max-old-space-size=4096 ./node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit && node scripts/check-platform-leaks.mjs && node scripts/check-contract-sync.mjs",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "tauri": "tauri",
    "tauri:dev": "tauri dev --config src-tauri/tauri.dev.conf.json",
    "tauri:build": "node scripts/build-portable.mjs",
    "build:portable": "node scripts/build-portable.mjs",
    "package:sign": "powershell -ExecutionPolicy Bypass -File scripts/sign-installers.ps1",
    "package:android": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Target arm64",
    "package:android:universal": "powershell -ExecutionPolicy Bypass -File scripts/build-android.ps1 -Target universal",
    "tauri:cli": "cargo install tauri-cli --locked"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/lang-python": "^6.2.1",
    "@codemirror/lang-sql": "^6.10.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/theme-one-dark": "^6.1.3",
    "@codemirror/view": "^6.43.9",
    "@fontsource-variable/fira-code": "^5.3.0",
    "@fontsource-variable/inconsolata": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@fontsource-variable/literata": "^5.3.0",
    "@fontsource-variable/plus-jakarta-sans": "^5.3.0",
    "@fontsource/atkinson-hyperlegible": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/source-code-pro": "^5.3.0",
    "@lezer/highlight": "^1.2.3",
    "@tailwindcss/vite": "^4.1.14",
    "@supabase/supabase-js": "^2.117.2",
    "@tauri-apps/api": "^2",
    "@vitejs/plugin-react": "^5.0.4",
    "canvas-confetti": "^1.9.4",
    "katex": "^0.18.5",
    "lucide-react": "^0.546.0",
    "mermaid": "^11.17.2",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/katex": "^0.16.8",
    "@types/node": "^22.14.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^30.1.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "vitest": "^5.0.0"
  }
}