{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CNTXT",
  "version": "0.7.1",
  "identifier": "com.cntxt.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "main",
        "title": "CNTXT",
        "width": 1280,
        "height": 800,
        "minWidth": 400,
        "minHeight": 350,
        "resizable": true,
        "decorations": false,
        "transparent": false,
        "theme": "Dark",
        "backgroundColor": "#141417",
        "shadow": true,
        "devtools": false,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https: blob: data:; style-src 'self' 'unsafe-inline' https: data:; img-src 'self' data: blob: asset: https:; font-src 'self' data: https: blob:; connect-src 'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:* https: wss:; frame-src 'self' data: blob: about: https:; worker-src 'self' blob: data: https:; object-src 'none'; base-uri 'self'; form-action 'self'",
      "dangerousDisableAssetCspModification": true
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis",
      "msi",
      "deb"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Modular Frontend UI & Prompt Engineering Platform",
    "longDescription": "CNTXT is a cross-platform desktop application for structured writing, prompt engineering, and workflow automation.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "depends": [
          "libgtk-3-0",
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "librsvg2-2",
          "xdg-utils"
        ],
        "section": "editors",
        "priority": "optional"
      }
    },
    "fileAssociations": [
      {
        "ext": [
          "md",
          "markdown",
          "mdown",
          "mkdn"
        ],
        "name": "Markdown Document",
        "description": "Markdown Document",
        "role": "Editor"
      },
      {
        "ext": [
          "txt",
          "text",
          "log",
          "ini",
          "conf",
          "cfg"
        ],
        "name": "Text Document",
        "description": "Plain Text Document",
        "role": "Editor"
      },
      {
        "ext": [
          "json",
          "csv",
          "tsv",
          "xml",
          "yaml",
          "yml",
          "toml"
        ],
        "name": "Data File",
        "description": "Structured Data File",
        "role": "Editor"
      },
      {
        "ext": [
          "html",
          "htm",
          "css",
          "svg"
        ],
        "name": "Web Document",
        "description": "HTML / CSS Document",
        "role": "Editor"
      },
      {
        "ext": [
          "py",
          "js",
          "jsx",
          "ts",
          "tsx",
          "sql",
          "sh",
          "bash",
          "bat",
          "cmd",
          "ps1",
          "rs",
          "c",
          "cpp",
          "h",
          "hpp",
          "java",
          "kt",
          "go",
          "rb",
          "php"
        ],
        "name": "Source Code",
        "description": "Source Code File",
        "role": "Editor"
      }
    ]
  }
}
